# AI Pocket server — example environment.
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不提交。
# 真实密钥只存在于本地 / CI 凭据系统，绝不写进仓库。

# 监听地址（IP）。默认 0.0.0.0（对外可达，由网关/防火墙收口）。
AI_POCKET_BIND=0.0.0.0

# 监听端口。默认 8080。
AI_POCKET_PORT=8080

# 鉴权密钥（必填，无默认值）。下方为占位值，请替换为强随机串。
# 生成示例：openssl rand -hex 32
AI_POCKET_AUTH_SECRET=replace-me-with-a-strong-random-secret

# 日志级别（RUST_LOG 兼容语法）。默认 info。
AI_POCKET_LOG=info
